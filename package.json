{
  "name": "prioritize-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./server --filter ./web dev",
    "build": "pnpm --filter ./web build && pnpm --filter ./server build",
    "start": "pnpm --filter ./server start",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter ./server db:generate",
    "db:migrate": "pnpm --filter ./server db:migrate"
  },
  "packageManager": "pnpm@12.11.2"
}
