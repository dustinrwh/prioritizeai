{
  "name": "prioritize-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./server --filter ./web dev",
    "build": "pnpm --filter ./web build && pnpm --filter ./server build",
    "start": "pnpm --filter ./server start",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "emulator": "sh scripts/emulator.sh",
    "seed": "pnpm --filter @prioritize/server seed"
  },
  "packageManager": "pnpm@12.11.2"
}
