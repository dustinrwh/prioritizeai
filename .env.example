# Local dev. Copy to .env
DATABASE_URL=postgres://localhost:5432/prioritize_ai
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
# Local only: enables POST /api/auth/dev and a "Dev sign-in" button
DEV_AUTH=1
# mock = canned heuristic suggestion (no GCP needed); vertex = real Vertex AI
AI_PROVIDER=mock
GCP_PROJECT=
GCP_LOCATION=us-central1
# Optional: overrides the built-in system prompt (Secret Manager in prod)
AI_SYSTEM_PROMPT=
PORT=8080
