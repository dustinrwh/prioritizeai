# Local dev. Copy to .env
# Local Firestore emulator (run `pnpm emulator`). Data is wiped when it stops; `pnpm seed` loads sample ideas.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
GCP_PROJECT=demo-prioritize-ai
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
# Local only: enables POST /api/auth/dev and a "Dev sign-in" button
DEV_AUTH=1
# mock = canned heuristic suggestion (no GCP needed); vertex = real Vertex AI (set GCP_PROJECT to a real project)
AI_PROVIDER=mock
GCP_LOCATION=us-central1
# Optional: overrides the built-in system prompt (Secret Manager in prod)
AI_SYSTEM_PROMPT=
PORT=8080
